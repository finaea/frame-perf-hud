// Generated into the build folder by pc/CMakeLists.txt (configure_file), so the font paths are absolute.
#include <windows.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/resource.h"

1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/app.manifest"

IDR_FONT_REGULAR RCDATA "@FPH_FONT_DIR@/NotoSans-Regular.ttf"
IDR_FONT_BOLD RCDATA "@FPH_FONT_DIR@/NotoSans-Bold.ttf"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "frame-perf-hud for Windows"
      VALUE "ProductName", "frame-perf-hud"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "FramePerfHud.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_SETTINGS DIALOGEX 0, 0, 280, 230
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "frame-perf-hud settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
  LTEXT "Headset IP address (only needed if the headset isn't found on its own):", -1, 10, 10, 260, 10
  EDITTEXT IDC_MANUAL_IP, 10, 23, 110, 14, ES_AUTOHSCROLL
  LTEXT "e.g. 192.168.1.47. Leave empty to search the network.", -1, 126, 26, 150, 10
  AUTOCHECKBOX "Start with Windows (in the tray)", IDC_AUTOSTART, 10, 46, 200, 12
  LTEXT "Camera frame rate (PC), 1-30 fps:", -1, 10, 66, 120, 10
  EDITTEXT IDC_CAMERA_FPS, 132, 63, 30, 14, ES_NUMBER
  AUTOCHECKBOX "Check for updates (at start and once a day)", IDC_UPDATE_CHECK, 10, 86, 190, 12
  PUSHBUTTON "Check now", IDC_UPDATE_NOW, 210, 85, 60, 14
  LTEXT "", IDC_UPDATE_STATUS, 10, 101, 260, 10
  LTEXT "", IDC_INFO, 10, 118, 260, 82
  PUSHBUTTON "Forget remembered headsets", IDC_FORGET, 10, 206, 112, 14
  DEFPUSHBUTTON "OK", IDOK, 166, 206, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 220, 206, 50, 14
END

IDD_RENAME DIALOGEX 0, 0, 220, 64
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename profile"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
  LTEXT "New name (up to 31 characters):", -1, 10, 8, 200, 10
  EDITTEXT IDC_RENAME_EDIT, 10, 21, 200, 14, ES_AUTOHSCROLL
  DEFPUSHBUTTON "Rename", IDOK, 106, 42, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 160, 42, 50, 14
END
